{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.vue",
    "src/preload/*.d.ts",
   
    // "src/preload/*.js"
  ],
    "exclude": [
     "src/renderer/src/assets/" ,
     "!src/renderer/src/assets/**/svg-sprite.ts",
      "!src/renderer/src/utils/pdfTextExtractor.ts"
  ],
  "compilerOptions": {
    "allowJs": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ]
    }
  }
}
